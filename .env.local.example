# Copy this file to .env.local and fill in the values.
#
# For local development with `npx supabase start`, run it once and copy the
# printed API URL / anon key / service_role key here (or `npx supabase status`
# to print them again). The values below are the standard Supabase CLI local
# dev keys and work out of the box for `npx supabase start` on this project.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# The restaurant shown at /menu while the app is single-tenant.
NEXT_PUBLIC_DEFAULT_RESTAURANT_SLUG=sabor-urbano

# Used to build absolute URLs (sitemap, OpenGraph, QR code). Change in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
